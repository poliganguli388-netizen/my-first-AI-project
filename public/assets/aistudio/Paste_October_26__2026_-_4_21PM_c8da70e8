/* AI Automation Engine */
async function callAI(prompt) {
  $('#ai-loading-text').style.display = 'inline';
  try {
    if (window.claude && window.claude.use) {
      const sample = await window.claude.use('sample');
      if (sample && sample.json) {
        return await sample.json(prompt);
      }
    }
  } catch (err) {
    console.warn("Claude window API not active, running built-in Smart AI engine.", err);
  } finally {
    $('#ai-loading-text').style.display = 'none';
