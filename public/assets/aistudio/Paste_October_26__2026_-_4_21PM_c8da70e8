<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Celebration & Event Planner Pro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #F8F9FC;
  --surface: #FFFFFF;
  --surface-2: #F1F4F9;
  --line: #E2E8F0;
  --ink: #0F172A;
  --muted: #64748B;
  --primary: #6366F1;
  --primary-hover: #4F46E5;
  --primary-subtle: #EEF2FF;
  --accent: #EC4899;
  --good: #10B981;
  --good-subtle: #ECFDF5;
  --warn: #F59E0B;
  --warn-subtle: #FFFBEB;
  --bad: #EF4444;
  --bad-subtle: #FEF2F2;
  --radius: 12px;
  --radius-sm: 8px;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
  --shadow: 0 4px 16px -2px rgba(15,23,42,0.08);
  --shadow-lg: 0 12px 32px -4px rgba(15,23,42,0.12);
  --f-body: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --f-mono: 'JetBrains Mono', monospace;
  --c1: #6366F1; --c2: #EC4899; --c3: #14B8A6; --c4: #F59E0B; --c5: #3B82F6;
  --c6: #8B5CF6; --c7: #10B981; --c8: #64748B; --c9: #F43F5E; --c10: #06B6D4;
}

[data-theme="dark"] {
  --bg: #0B0F19;
  --surface: #131A29;
  --surface-2: #1B2436;
  --line: #26324A;
  --ink: #F8FAFC;
  --muted: #94A3B8;
  --primary: #818CF8;
  --primary-hover: #6366F1;
  --primary-subtle: rgba(99,102,241,0.15);
  --accent: #F472B6;
  --good: #34D399;
  --good-subtle: rgba(16,185,129,0.15);
  --warn: #FBBF24;
  --warn-subtle: rgba(245,158,11,0.15);
  --bad: #F87171;
  --bad-subtle: rgba(239,68,68,0.15);
  --shadow: 0 4px 20px rgba(0,0,0,0.3);
  --shadow-lg: 0 12px 40px rgba(0,0,0,0.45);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--f-body);
  font-size: 14.5px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
input, button, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; border: none; background: transparent; }
:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

.num { font-family: var(--f-mono); font-variant-numeric: tabular-nums; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

/* Top Nav */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
}
.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 17px; }
.brand-icon {
  width: 32px; height: 32px; border-radius: 8px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  display: flex; align-items: center; justify-content: center; color: #fff; font-size: 16px;
}
.nav-actions { display: flex; align-items: center; gap: 8px; }

/* Hero Section */
.hero {
  background: var(--surface);
  border-bottom: 1px solid var(--line);
  padding: 32px 0 28px;
  box-shadow: var(--shadow-sm);
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 24px;
  align-items: center;
}
.title-input {
  width: 100%;
  font-size: clamp(24px, 4vw, 34px);
  font-weight: 800;
  color: var(--ink);
  border: 1px dashed transparent;
  background: transparent;
  border-radius: var(--radius-sm);
  padding: 4px 6px;
  margin-left: -6px;
  transition: border-color .2s;
}
.title-input:hover, .title-input:focus {
  border-color: var(--line);
  background: var(--surface-2);
}
.meta-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.meta-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border-radius: 999px;
  background: var(--surface-2);
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
  border: 1px solid var(--line);
}

.countdown-box {
  background: linear-gradient(135deg, var(--surface-2), var(--surface));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
}
.cd-unit { text-align: center; }
.cd-unit .val { font-size: 32px; font-weight: 800; color: var(--primary); font-family: var(--f-mono); line-height: 1; }
.cd-unit .lbl { font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-top: 4px; letter-spacing: 0.05em; }
.cd-sep { font-size: 24px; color: var(--line); font-weight: 300; }

/* Buttons & Inputs */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-size: 13.5px;
  font-weight: 600;
  transition: all .15s ease;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--ink);
  white-space: nowrap;
}
.btn:hover { background: var(--surface-2); border-color: var(--muted); }
.btn-primary {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}
.btn-primary:hover { background: var(--primary-hover); }
.btn-ai {
  background: linear-gradient(135deg, #6366F1, #EC4899);
  color: #fff;
  border: none;
  font-weight: 700;
  box-shadow: 0 4px 14px rgba(236,72,153,0.25);
}
.btn-ai:hover { filter: brightness(1.1); transform: translateY(-1px); }
.btn-sm { padding: 5px 10px; font-size: 12.5px; }

/* Cards & Layout */
.main-content { padding: 28px 0 60px; display: grid; gap: 24px; }
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 22px;
  box-shadow: var(--shadow-sm);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  flex-wrap: wrap;
  gap: 12px;
}
.card-title { font-size: 17px; font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: 8px; }

/* Form Fields */
.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}
.form-col-wide { grid-column: 1 / -1; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em; }
.field input, .field select, .field textarea {
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 9px 12px;
  font-size: 14px;
  color: var(--ink);
  transition: border-color .15s;
}
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--primary); outline: none; }
.field textarea { resize: vertical; min-height: 70px; }

/* AI Actions Bar */
.ai-actions-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--line);
}

/* Tabs */
.tabs-nav {
  display: flex;
  gap: 6px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 20px;
  overflow-x: auto;
  padding-bottom: 2px;
}
.tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--muted);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  border-bottom: 3px solid transparent;
  white-space: nowrap;
}
.tab-btn:hover { color: var(--ink); background: var(--surface-2); }
.tab-btn.active {
  color: var(--primary);
  border-bottom-color: var(--primary);
  background: var(--primary-subtle);
}
.badge {
  font-family: var(--f-mono);
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 999px;
  background: var(--line);
  color: var(--ink);
  font-weight: 600;
}
.tab-btn.active .badge { background: var(--primary); color: #fff; }

/* Financial Cards & Progress Bar */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}
.stat-card {
  padding: 14px;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  border: 1px solid var(--line);
}
.stat-card .slbl { font-size: 11.5px; font-weight: 700; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
.stat-card .sval { font-size: 21px; font-weight: 700; font-family: var(--f-mono); }
.stat-card .sval.good { color: var(--good); }
.stat-card .sval.bad { color: var(--bad); }

.budget-bar {
  height: 18px;
  display: flex;
  border-radius: 6px;
  overflow: hidden;
  background: var(--line);
  gap: 2px;
  margin-bottom: 12px;
}
.budget-bar span { height: 100%; transition: width .3s; }

/* Table/List Rows */
.plan-list { display: grid; gap: 10px; }
.plan-row {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  transition: transform .1s, border-color .15s;
}
.plan-row:hover { border-color: var(--muted); }
.plan-row.completed { opacity: 0.65; background: var(--surface-2); }
.plan-row.completed .row-title { text-decoration: line-through; }

/* Tag Chips */
.status-pill {
  font-size: 11px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.pill-good { background: var(--good-subtle); color: var(--good); }
.pill-warn { background: var(--warn-subtle); color: var(--warn); }
.pill-bad { background: var(--bad-subtle); color: var(--bad); }
.pill-primary { background: var(--primary-subtle); color: var(--primary); }

/* Add Toolbars */
.add-box {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px dashed var(--line);
}
.add-box input, .add-box select {
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  font-size: 13.5px;
}

/* Modal Window */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 1000;
}
.modal-backdrop[hidden] { display: none !important; }
.modal-window {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  max-width: 580px;
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-lg);
  animation: modalIn .2s ease-out;
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}
.modal-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.modal-body { padding: 20px; overflow-y: auto; font-size: 14px; }
.modal-footer {
  padding: 14px 20px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

/* Toast */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: #0F172A;
  color: #fff;
  border-radius: 999px;
  padding: 10px 20px;
  font-size: 13.5px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  z-index: 2000;
}
.toast[hidden] { display: none; }
.toast button { color: #EC4899; font-weight: 700; }

@media (max-width: 768px) {
  .hero-grid { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: 1fr 1fr; }
}

@media print {
  body { background: #fff !important; color: #000 !important; }
  .top-nav, .actions, .add-box, .btn, .tabs-nav, .theme-btn, .ai-actions-bar { display: none !important; }
  .card { border: 1px solid #ccc !important; box-shadow: none !important; margin-bottom: 20px; }
}
</style>
</head>
<body>

<!-- Navigation -->
<header class="top-nav">
  <div class="wrap" style="display:flex; justify-content:space-between; align-items:center; width:100%;">
    <div class="brand">
      <div class="brand-icon">✨</div>
      <span>EventCraft AI</span>
    </div>
    <div class="nav-actions">
      <button class="btn btn-sm" id="btn-theme" title="Toggle Dark/Light Mode">🌙 Theme</button>
      <button class="btn btn-sm" id="btn-print" title="Print Run Sheet / Plan">🖨️ Export PDF</button>
    </div>
  </div>
</header>

<!-- Hero Event Summary -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <input type="text" id="f-name" class="title-input" aria-label="Event Title" placeholder="Enter Event Title...">
      <div class="meta-chips">
        <span class="meta-chip">📅 <span id="chip-date">Loading...</span></span>
        <span class="meta-chip">👥 <span id="chip-guests">0</span> Guests</span>
        <span class="meta-chip">📍 <span id="chip-city">Anywhere</span></span>
        <span class="meta-chip" id="chip-type">Wedding</span>
      </div>
    </div>
    <div class="countdown-box">
      <div class="cd-unit">
        <div class="val" id="cd-d">0</div>
        <div class="lbl">Days</div>
      </div>
      <div class="cd-sep">:</div>
      <div class="cd-unit">
        <div class="val" id="cd-h">0</div>
        <div class="lbl">Hours</div>
      </div>
      <div class="cd-sep">:</div>
      <div class="cd-unit">
        <div class="val" id="cd-m">0</div>
        <div class="lbl">Mins</div>
      </div>
      <div class="cd-sep">:</div>
      <div class="cd-unit">
        <div class="val" id="cd-s">0</div>
        <div class="lbl">Secs</div>
      </div>
    </div>
  </div>
</section>

<!-- Main App Area -->
<main class="wrap main-content">
  <!-- Event Parameters -->
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">⚙️ Event Setup & Parameters</h2>
      <div style="display:flex; gap:8px;">
        <button class="btn btn-sm" id="btn-reset">Load Starter Template</button>
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label>Event Type</label>
        <select id="f-type">
          <option value="wedding">Indian Wedding / Sangeet</option>
          <option value="birthday">Birthday Milestone</option>
          <option value="anniversary">Anniversary Celebration</option>
          <option value="corporate">Corporate Gala / Summit</option>
          <option value="community">Community / Festival Event</option>
        </select>
      </div>
      <div class="field">
        <label>Event Date</label>
        <input type="date" id="f-date">
      </div>
      <div class="field">
        <label>Guest Count</label>
        <input type="number" id="f-guests" min="1" placeholder="100">
      </div>
      <div class="field">
        <label>Total Budget (₹)</label>
        <input type="number" id="f-budget" min="0" step="5000" placeholder="500000">
      </div>
      <div class="field">
        <label>City / Location</label>
        <input type="text" id="f-city" placeholder="e.g. Mumbai, Goa, Jaipur">
      </div>
      <div class="field form-col-wide">
        <label>Host Vision & Preferences</label>
        <textarea id="f-notes" placeholder="Theme, vegetarian menu preferences, live band music, outdoor lawn with rain cover..."></textarea>
      </div>
    </div>

    <!-- AI Automation Bar -->
    <div class="ai-actions-bar">
      <button class="btn btn-ai" id="btn-ai-full">🪄 AI Auto-Plan Everything</button>
      <button class="btn" id="btn-ai-invite">✉️ AI WhatsApp Invite</button>
      <button class="btn" id="btn-ai-budget">💡 AI Budget Doctor</button>
      <button class="btn" id="btn-ai-questions">📋 AI Vendor Checklist</button>
      <span id="ai-loading-text" style="display:none; font-size:13px; color:var(--primary); font-weight:600;">✨ AI is analyzing & generating...</span>
    </div>
  </section>

  <!-- Financial Health -->
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">📊 Financial & Allocation Health</h2>
      <span id="per-guest-indicator" class="status-pill pill-primary">₹0 / guest</span>
    </div>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="slbl">Total Budget</div>
        <div class="sval" id="stat-total">₹0</div>
      </div>
      <div class="stat-card">
        <div class="slbl">Planned Allocation</div>
        <div class="sval" id="stat-planned">₹0</div>
      </div>
      <div class="stat-card">
        <div class="slbl">Actual Paid Out</div>
        <div class="sval" id="stat-spent">₹0</div>
      </div>
      <div class="stat-card">
        <div class="slbl">Remaining Balance</div>
        <div class="sval" id="stat-remaining">₹0</div>
      </div>
    </div>
    <div class="budget-bar" id="budget-progress" title="Category distribution"></div>
    <p id="budget-insight-note" style="font-size:13px; color:var(--muted);"></p>
  </section>

  <!-- Interactive Modules -->
  <section class="card">
    <div class="tabs-nav" role="tablist">
      <button class="tab-btn active" data-tab="budget">💰 Budget Breakdown <span class="badge" id="b-badge">0</span></button>
      <button class="tab-btn" data-tab="timeline">📅 Timeline & Tasks <span class="badge" id="t-badge">0</span></button>
      <button class="tab-btn" data-tab="schedule">⏰ Day-of Run Sheet <span class="badge" id="s-badge">0</span></button>
      <button class="tab-btn" data-tab="vendors">🤝 Vendors & Quotes <span class="badge" id="v-badge">0</span></button>
      <button class="tab-btn" data-tab="guests">👥 Guests & RSVP <span class="badge" id="g-badge">0</span></button>
      <button class="tab-btn" data-tab="ideas">💡 Creative Ideas <span class="badge" id="i-badge">0</span></button>
    </div>

    <!-- Tab Panels Container -->
    <div id="tab-content"></div>
  </section>
</main>

<!-- Unified Modal for AI Outputs & Utilities -->
<div class="modal-backdrop" id="modal" hidden>
  <div class="modal-window">
    <div class="modal-header">
      <h3 id="modal-title" style="font-size:16px; font-weight:700;">AI Assistant</h3>
      <button class="btn btn-sm" id="modal-close">✕</button>
    </div>
    <div class="modal-body" id="modal-body"></div>
    <div class="modal-footer" id="modal-footer">
      <button class="btn" id="modal-copy">Copy to Clipboard</button>
      <button class="btn btn-primary" id="modal-done">Done</button>
    </div>
  </div>
</div>

<!-- Notification Toast -->
<div class="toast" id="toast" hidden>
  <span id="toast-text">Message</span>
  <button id="toast-action" hidden>Undo</button>
</div>

<script>
