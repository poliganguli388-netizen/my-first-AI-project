let state = loadInitialState();
let countdownTimer = null;

function loadInitialState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (e) { console.warn(e); }
  return buildStateFromStarter(STARTERS.wedding);
}

function buildStateFromStarter(tpl) {
  const future = new Date();
  future.setDate(future.getDate() + 45);

  const totalB = tpl.budget;
  let allocated = 0;
  const budgetRows = tpl.categories.map((c, i) => {
    let amt = Math.round((c.pct / 100) * totalB / 1000) * 1000;
    if (i === tpl.categories.length - 1) amt = Math.max(0, totalB - allocated);
    allocated += amt;
    return { id: uid(), name: c.name, planned: amt, spent: Math.round(amt * 0.25) };
  });

  return {
    theme: 'light',
    name: tpl.title,
    type: 'wedding',
    date: future.toISOString().split('T')[0],
    guests: tpl.guests,
    budget: tpl.budget,
    city: tpl.city,
    notes: tpl.notes,
    activeTab: 'budget',
    budgetRows,
    tasks: tpl.tasks.map(t => ({ id: uid(), text: t.text, weeks: t.weeks, done: false })),
    schedule: tpl.schedule.map(s => ({ id: uid(), time: s.time, event: s.event, lead: s.lead })),
    vendors: tpl.vendors.map(v => ({ id: uid(), ...v })),
    guestList: tpl.guests.map(g => ({ id: uid(), ...g })),
    ideas: tpl.ideas.map(i => ({ id: uid(), ...i }))
  };
}

function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
}

function uid() { return Math.random().toString(36).substr(2, 9); }
const formatINR = num => '₹' + new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(num || 0));

const $ = sel => document.querySelector(sel);
const $$ = sel => document.querySelectorAll(sel);

function init() {
  applyTheme(state.theme || 'light');
  syncFormFields();
  startCountdown();
  renderHeaderMeta();
  renderFinance();
  renderTabContent();
  bindEvents();
}

function applyTheme(theme) {
  state.theme = theme;
  document.documentElement.setAttribute('data-theme', theme);
  $('#btn-theme').textContent = theme === 'dark' ? '☀️ Light' : '🌙 Dark';
  saveState();
}

function syncFormFields() {
  $('#f-name').value = state.name;
  $('#f-type').value = state.type || 'wedding';
  $('#f-date').value = state.date;
  $('#f-guests').value = state.guests;
  $('#f-budget').value = state.budget;
  $('#f-city').value = state.city;
  $('#f-notes').value = state.notes;
}

function renderHeaderMeta() {
  $('#chip-date').textContent = state.date ? new Date(state.date).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date not set';
  $('#chip-guests').textContent = state.guests || 0;
  $('#chip-city').textContent = state.city || 'Anywhere';
  $('#chip-type').textContent = state.type ? state.type.toUpperCase() : 'EVENT';
}

function startCountdown() {
  if (countdownTimer) clearInterval(countdownTimer);
  const update = () => {
    if (!state.date) return;
    const target = new Date(state.date + 'T00:00:00');
    const now = new Date();
    const diff = target - now;

    if (diff <= 0) {
      $('#cd-d').textContent = '00';
      $('#cd-h').textContent = '00';
      $('#cd-m').textContent = '00';
      $('#cd-s').textContent = '00';
      return;
    }

    const d = Math.floor(diff / (1000 * 60 * 60 * 24));
    const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const m = Math.floor((diff / 1000 / 60) % 60);
    const s = Math.floor((diff / 1000) % 60);

    $('#cd-d').textContent = String(d).padStart(2, '0');
    $('#cd-h').textContent = String(h).padStart(2, '0');
    $('#cd-m').textContent = String(m).padStart(2, '0');
    $('#cd-s').textContent = String(s).padStart(2, '0');
  };
  update();
  countdownTimer = setInterval(update, 1000);
}

function renderFinance() {
  const totalB = Number(state.budget) || 0;
  let planned = 0, spent = 0;
  state.budgetRows.forEach(r => {
    planned += Number(r.planned) || 0;
    spent += Number(r.spent) || 0;
  });

  const remaining = totalB - spent;
  const perGuest = state.guests > 0 ? Math.round(totalB / state.guests) : 0;

  $('#stat-total').textContent = formatINR(totalB);
  $('#stat-planned').textContent = formatINR(planned);
  $('#stat-spent').textContent = formatINR(spent);
  $('#stat-remaining').textContent = formatINR(remaining);
  $('#stat-remaining').className = 'sval ' + (remaining < 0 ? 'bad' : 'good');
  $('#per-guest-indicator').textContent = formatINR(perGuest) + ' / guest';

  let barHtml = '';
  const denominator = Math.max(totalB, planned, 1);
  state.budgetRows.forEach((r, idx) => {
    const width = ((r.planned || 0) / denominator) * 100;
    if (width > 0) {
      barHtml += `<span style="width:${width}%; background:${COLORS[idx % COLORS.length]};" title="${r.name}: ${formatINR(r.planned)}"></span>`;
    }
  });
  $('#budget-progress').innerHTML = barHtml;

  const diff = totalB - planned;
  const noteEl = $('#budget-insight-note');
  if (diff < 0) {
    noteEl.textContent = `⚠️ Planned category spend exceeds your budget limit by ${formatINR(Math.abs(diff))}. Adjust allocations.`;
    noteEl.style.color = 'var(--bad)';
  } else if (diff > 0) {
    noteEl.textContent = `💡 You still have ${formatINR(diff)} unassigned in reserve.`;
    noteEl.style.color = 'var(--muted)';
  } else {
    noteEl.textContent = `✨ 100% of your budget has been precisely allocated across categories.`;
    noteEl.style.color = 'var(--good)';
  }

  $('#b-badge').textContent = state.budgetRows.length;
  $('#t-badge').textContent = `${state.tasks.filter(t => t.done).length}/${state.tasks.length}`;
  $('#s-badge').textContent = state.schedule.length;
  $('#v-badge').textContent = state.vendors.length;
  $('#g-badge').textContent = state.guestList.length;
  $('#i-badge').textContent = state.ideas.length;
}

function renderTabContent() {
  const container = $('#tab-content');
  $$('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === state.activeTab));

  switch (state.activeTab) {
    case 'budget': container.innerHTML = getBudgetTabHtml(); break;
    case 'timeline': container.innerHTML = getTimelineTabHtml(); break;
    case 'schedule': container.innerHTML = getScheduleTabHtml(); break;
    case 'vendors': container.innerHTML = getVendorsTabHtml(); break;
    case 'guests': container.innerHTML = getGuestsTabHtml(); break;
    case 'ideas': container.innerHTML = getIdeasTabHtml(); break;
  }
}

