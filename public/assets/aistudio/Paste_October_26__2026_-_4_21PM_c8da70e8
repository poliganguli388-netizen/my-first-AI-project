};

window.addVendor = function() {
  const name = $('#new-v-name').value.trim();
  const cat = $('#new-v-cat').value.trim() || 'General';
  const quote = Number($('#new-v-quote').value) || 0;
  if (!name) return;
  state.vendors.push({ id: uid(), name, cat, quote, status: 'To Contact', note: '' });
