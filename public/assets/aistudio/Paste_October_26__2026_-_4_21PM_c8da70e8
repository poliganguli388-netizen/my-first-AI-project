/* Global Mutators */
window.updateItem = function(collection, id, field, val) {
  const item = state[collection].find(x => x.id === id);
  if (item) {
    item[field] = val;
    saveState();
    renderFinance();
  }
};

window.removeItem = function(collection, id) {
  state[collection] = state[collection].filter(x => x.id !== id);
  saveState();
  renderFinance();
  renderTabContent();
  showToast('Item deleted');
};

window.toggleTaskDone = function(id, done) {
  const task = state.tasks.find(t => t.id === id);
  if (task) {
    task.done = done;
    saveState();
    renderFinance();
    renderTabContent();
  }
};

window.addBudgetCategory = function() {
  const name = $('#new-b-name').value.trim();
  const amt = Number($('#new-b-amt').value) || 0;
  if (!name) return;
  state.budgetRows.push({ id: uid(), name, planned: amt, spent: 0 });
  saveState();
  renderFinance();
  renderTabContent();
};

window.addTask = function() {
  const text = $('#new-t-text').value.trim();
  const weeks = Number($('#new-t-weeks').value) || 0;
  if (!text) return;
  state.tasks.push({ id: uid(), text, weeks, done: false });
  saveState();
  renderFinance();
  renderTabContent();
};

window.addSchedule = function() {
  const time = $('#new-s-time').value.trim() || '12:00 PM';
  const event = $('#new-s-event').value.trim();
  const lead = $('#new-s-lead').value.trim() || 'Host';
  if (!event) return;
  state.schedule.push({ id: uid(), time, event, lead });
